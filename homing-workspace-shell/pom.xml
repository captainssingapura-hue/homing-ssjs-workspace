<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.captainssingapura-hue.homing.js.ws</groupId>
        <artifactId>homing.js.ws</artifactId>
        <version>LOCAL-SNAPSHOT</version>
    </parent>

    <artifactId>homing-workspace-shell</artifactId>

    <description>
        Universal workspace chrome substrate — the orchestrator and its
        sub-classes that every WorkspaceShell-derived AppModule shares.

        Born from a refactor: prior to this module, the entire workspace
        boot sequence (WorkspaceLayout mount, MTP wiring, picker plumbing,
        persistence attach, identity resolution, event-log + replay,
        checkpoint store, Web Lock + read-only fence) lived as ~2,100 lines
        of JS-as-Java-string-literals inside per-workspace chrome widgets
        (e.g. AnimalsPlaygroundChrome.bodyJs() in homing-demo). This
        module promotes that mass into proper ES modules — one class per
        responsibility, each independently testable.

        Doctrines made concrete:

        - Modest File Size: every class sits comfortably under the cap.
        - Generated and Hand-Written Live Apart: JS lives in .js files,
          not Java string-literal lists.
        - Functional Objects: each JS class has explicit state, pure
          behaviour, inspect() output (extended from the Java doctrine).
        - Diligent Secretaries: every component is testable in isolation
          via the GraalVM harness without a DOM.

        Position in the dep graph: sits above homing-workspace-persistence
        (the highest workspace utility module) so it can compose every
        substrate piece below.
    </description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- RFC 0066 E3 - the framework page model the workspace is a page OF.
             WorkspaceApp is an AppModule under a StandardMpa, and the slot it
             fills says it lays itself out by wearing the MPA main-full word. The
             studio mounting needs none of this; a standalone workspace is
             nothing but this. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-site-mpa</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <!-- The MPA's implementation - StandardMpa, its page, its chrome - from the
             ui-components repo; core's homing-site-mpa above holds the definitions. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-site-mpa-standard</artifactId>
            <version>${homing.components.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-design-core</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <!-- The context menus: the steward, the typed tree, the icons on it. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ui-menu</artifactId>
            <version>${homing.components.version}</version>
        </dependency>

        <!-- The three the workspace's panes are made of: the grid arranges,
             a dock holds tabs, the desk carries what floats. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ui-splitgrid</artifactId>
            <version>${homing.components.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ui-panes</artifactId>
            <version>${homing.components.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ui-docking</artifactId>
            <version>${homing.components.version}</version>
        </dependency>

        <!-- The Dialog component the switcher opens: the first of the studio's
             UI this stack swapped out. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ui-dialog</artifactId>
            <version>${homing.components.version}</version>
        </dependency>

        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.ws</groupId>
            <artifactId>homing-workspace</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.ws</groupId>
            <artifactId>homing-workspace-codecs</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.ws</groupId>
            <artifactId>homing-workspace-persistence</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- GraalVM-backed JS test harness — each shell sub-class gets a
             Diligent-Secretaries-style unit test in isolation, no DOM. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ssjs-test-fixtures</artifactId>
            <version>${homing.core.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The gate (ShellConformanceTest), headless: the rules, the engine that
             grades the served artifacts, and the designs every pair the shell's
             sheets wear must be bound in. Test scope: the shell chooses no design;
             a site does. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-conformance-rules</artifactId>
            <version>${homing.core.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-conformance-engine</artifactId>
            <version>${homing.core.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-designs</artifactId>
            <version>${homing.core.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
