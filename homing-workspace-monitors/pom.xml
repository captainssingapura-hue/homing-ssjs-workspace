<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.captainssingapura-hue.homing.js.ws</groupId>
        <artifactId>homing.js.ws</artifactId>
        <version>LOCAL-SNAPSHOT</version>
    </parent>

    <artifactId>homing-workspace-monitors</artifactId>

    <description>
        The monitors, as widgets: the page's parties on view - the focus tree,
        the steward's lamp, the DomOps tree, what the parties say - each a
        self-contained widget like any other, made with a container and its
        params, its DomOpsParty and FocusParty roots its own, for a host to
        graft. What they watch is the page's, read and never written.
    </description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- What a widget is, and the sheet it fills its container by. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.ws</groupId>
            <artifactId>homing-workspace-widgets</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <!-- The focus tree and the steward's lamp, as components: a monitor widget wraps them. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ui-focus</artifactId>
            <version>${homing.components.version}</version>
        </dependency>
        <!-- The parties a monitor reads, and its own; the keys. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-core-js</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-component-base</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-design-core</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <!-- RUNNABLE: the shell's workspace page, handed this set's manifest; the site it is a page of,
             the standard MPA, the designs it wears, and the server's routes beside the site's. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.ws</groupId>
            <artifactId>homing-workspace-shell</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-site-base</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-site-mpa</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-site-mpa-standard</artifactId>
            <version>${homing.components.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-designs</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The gate (MonitorsConformanceTest), headless, as the widgets'. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-conformance-rules</artifactId>
            <version>${homing.core.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-conformance-engine</artifactId>
            <version>${homing.core.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- mvn -pl homing-workspace-monitors exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>hue.captains.singapura.js.homing.workspace.monitors.MonitorsWorkspaceServer</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
