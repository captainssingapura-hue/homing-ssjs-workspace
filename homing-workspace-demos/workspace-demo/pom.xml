<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.captainssingapura-hue.homing.js.ws</groupId>
        <artifactId>homing-workspace-demos</artifactId>
        <version>LOCAL-SNAPSHOT</version>
    </parent>

    <artifactId>workspace-demo</artifactId>

    <description>
        The workspace, standing up on its own: a site with one page, the
        shell mounted on it, a spec to fill it, and a server to answer.

        Empty of application for now, and deliberately so — the front door is
        this stage's work, and the module exists first so that everything
        after it has somewhere to land and something to fail in.
    </description>

    <dependencies>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.ws</groupId>
            <artifactId>homing-workspace-shell</artifactId>
            <version>${project.parent.version}</version>
        </dependency>

        <!-- The substrate a page and a server come from: Site, Router and
             Navigable, and the host that serves one. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-site-base</artifactId>
            <version>${homing.core.version}</version>
        </dependency>

        <!-- The framework page model: StandardMpa, Brand and the page a JS app
             becomes. Explicit though the shell brings it: this module names it. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-site-mpa</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <!-- The MPA's implementation - StandardMpa, its page, its chrome - from the
             ui-components repo; core's homing-site-mpa above holds the definitions. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-site-mpa-standard</artifactId>
            <version>${homing.components.version}</version>
        </dependency>

        <!-- The button the demo counter is built from. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ui-elements</artifactId>
            <version>${homing.components.version}</version>
        </dependency>

        <!-- The relation grid and tree the demo's Books and Shelves views are
             built on, and the protocol the tree's relation answers in. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.ssjs</groupId>
            <artifactId>rel-grid</artifactId>
            <version>${homing.relgrid.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.ssjs</groupId>
            <artifactId>rel-tree</artifactId>
            <version>${homing.relgrid.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.ssjs</groupId>
            <artifactId>rel-grid-protocol</artifactId>
            <version>${homing.relgrid.version}</version>
        </dependency>

        <!-- The designs the page wears: the framework's, and nothing legacy. A
             theme registry is a SITE's choice; this one is HomingDesigns.REGISTRY. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-designs</artifactId>
            <version>${homing.core.version}</version>
        </dependency>

        <!-- The gate, headless. NOT homing-conformance-studio: that one is
             itself a workspace application, and taking it here would pull
             core's copy of this very stack onto the classpath beside ours. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-conformance-rules</artifactId>
            <version>${homing.core.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- mvn -pl homing-workspace-demos/workspace-demo exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>hue.captains.singapura.js.homing.workspace.demo.WorkspaceDemoServer</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
