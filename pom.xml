<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The ws sub-domain of homing.js: the workspace, on its own, as a thing
         that can be released and run without the studio around it.

         COPIED, NOT MOVED. The four modules below began as core's, and core
         keeps its own copy running under the studio: nothing there points at
         this repo, so nothing there breaks while this one changes. The two
         copies carry the same Java packages on purpose — an existing
         WorkspaceSpec or catalogue declaration compiles against this artifact
         with no edit, only a coordinate change — which is also why no single
         consumer may depend on both. One consumer, one copy, until core's is
         retired.

         The stage this repo is for: replace the workspace's UI layer with the
         ui-components, give it a front door of its own, and end with a
         standalone workspace application. -->
    <groupId>io.github.captainssingapura-hue.homing.js.ws</groupId>
    <artifactId>homing.js.ws</artifactId>
    <version>LOCAL-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <!-- The core's models: the vocabulary the core and the log share - a widget's id. Depends on nothing. -->
        <module>homing-workspace-core-models</module>
        <!-- The workspace's value objects, declared in Java: the log's events and state. -->
        <module>homing-workspace</module>
        <!-- Their generators. -->
        <module>homing-workspace-codecs</module>
        <!-- What the generators write (output-only): the Java codecs, and the JS modules - one per
             top-level Java declaration - with the Java that serves them. -->
        <module>homing-workspace-log-codec</module>
        <!-- The workspace log: the store, the exporter, the fold and the validator, in both languages. -->
        <module>homing-workspace-log</module>
        <!-- The workspace as a page: the desk and its docks, the recorder, the restore. -->
        <module>homing-workspace-shell</module>
        <!-- The messaging parties: a party's type declared in Java, and the flat instance a widget joins. -->
        <module>homing-workspace-parties</module>
        <!-- The workspace's headless core: the roster, its ids, the widgets' life; the parties beside it. Its dual in Java. -->
        <module>homing-workspace-core</module>
        <!-- The log's layers, live and headless: the roster recorded and come back to; the one pane, and its layer. -->
        <module>homing-workspace-layers</module>
        <!-- The widgets, each self-contained: made with a container and its params, its roots its own. -->
        <module>homing-workspace-widgets</module>
        <!-- The monitors, as widgets: the page's parties on view, each monitor self-contained. -->
        <module>homing-workspace-monitors</module>
        <!-- One widget on a page of its own, from its kind and its params on the address: the bench. -->
        <module>homing-widget-bench</module>
        <!-- The repo's own demos, nested: a workspace is a thing you run, and
             a module that runs one is the only honest test of that. -->
        <module>homing-workspace-demos</module>
        <!-- The conformance of this repo's crates, graded on every build; and the studio that shows the
             report, on 8099 - apart, on core's studio stack. Local, for development and review. -->
        <module>homing-workspace-conformance</module>
        <module>homing-workspace-conformance-studio</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- The substrate, from the core repo. Its own version, not ours:
             this repo releases on its own clock. -->
        <homing.core.version>LOCAL-SNAPSHOT</homing.core.version>
        <!-- The ui-components (and the MPA's standard implementation), from the
             homing-ssjs-ui-components repo: moved out of core, same coordinates,
             their own version. -->
        <homing.components.version>LOCAL-SNAPSHOT</homing.components.version>
        <!-- The relation grid family (a repo of its own), for the demo's views. -->
        <homing.relgrid.version>LOCAL-SNAPSHOT</homing.relgrid.version>
        <junit.version>5.11.3</junit.version>
        <jacoco.version>0.8.14</jacoco.version>
        <graalvm.version>24.1.1</graalvm.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
