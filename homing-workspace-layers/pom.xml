<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.captainssingapura-hue.homing.js.ws</groupId>
        <artifactId>homing.js.ws</artifactId>
        <version>LOCAL-SNAPSHOT</version>
    </parent>

    <artifactId>homing-workspace-layers</artifactId>

    <description>
        The workspace log's layers, live and headless (RFC 0066 E3, the
        workspace detour: the log, multiplexed): each layer's events recorded
        as they happen, and its state come back to - the roster's, beside the
        core, never in it; and the one pane's, with the pane's own headless
        placement. The log is one sequence; what folds it is the log's
        (homing-workspace-log). It touches no DOM and imports no DOM module.
        Every part has its dual in Java (A Good Design Doesn't Pick Up Its
        Substrate), the two held to the same lines by parity tests.
    </description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- The module model its JavaScript is served by. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-core</artifactId>
            <version>${homing.core.version}</version>
        </dependency>
        <!-- What is recorded and come back to: the log's value objects, and their classes and codecs in JavaScript. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.ws</groupId>
            <artifactId>homing-workspace</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.ws</groupId>
            <artifactId>homing-workspace-log-codec</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <!-- Whose word the roster's layer records, and whom it brings back. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.ws</groupId>
            <artifactId>homing-workspace-core</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The fold, to come back from what was recorded, in the parity tests. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js.ws</groupId>
            <artifactId>homing-workspace-log</artifactId>
            <version>${project.parent.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The JavaScript run headless, and held to the Java (the parity tests). -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-ssjs-test-fixtures</artifactId>
            <version>${homing.core.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The gate, headless. -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-conformance-rules</artifactId>
            <version>${homing.core.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.js</groupId>
            <artifactId>homing-conformance-engine</artifactId>
            <version>${homing.core.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
